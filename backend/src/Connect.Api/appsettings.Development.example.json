{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ConnectDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Secret": "[YOUR_DEV_SECRET_HERE_MINIMUM_32_CHARS]",
    "Issuer": "ConnectApi",
    "Audience": "ConnectClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "AllowedOrigins": [
    "http://localhost:8080",
    "http://127.0.0.1:8080"
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "System": "Warning"
      }
    }
  }
}
